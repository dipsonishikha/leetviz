(define/contract (two-sum nums target)
  (-> (listof exact-integer?) exact-integer? (listof exact-integer?))
  (let loop ([i 0] [xs nums] [seen (hash)])
    (if (null? xs) '() (let ()
    (define x (car xs))
    (define need (- target x))
    (if (hash-has-key? seen need)
        (list (hash-ref seen need) i)
        (loop (add1 i) (cdr xs) (hash-set seen x i)))))))
